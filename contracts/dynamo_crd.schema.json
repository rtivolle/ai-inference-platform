{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.com/schemas/dynamo_crd.schema.json",
  "title": "DynamoGraphDeploymentCRD",
  "description": "Validation schema for NVIDIA DynamoGraphDeployment Custom Resource (supporting v1alpha1 and v1beta1)",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["nvidia.com/v1alpha1", "nvidia.com/v1beta1"]
    },
    "kind": {
      "type": "string",
      "const": "DynamoGraphDeployment"
    },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "labels": { "type": "object" },
        "annotations": { "type": "object" }
      }
    },
    "spec": {
      "type": "object",
      "properties": {
        "backend": { "type": "string" },
        "backendFramework": { "type": "string" },
        "model": { "type": "string" },
        "sharedStorage": { "type": "object" },
        "services": { "type": "object" },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "replicas"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["frontend", "worker", "prefill", "decode", "planner", "EPP"] },
              "replicas": { "type": "integer", "minimum": 1 },
              "podTemplate": { "type": "object" }
            }
          }
        }
      }
    }
  }
}
