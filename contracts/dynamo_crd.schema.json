{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.com/schemas/dynamo_crd.schema.json",
  "title": "DynamoGraphDeploymentCRD",
  "description": "Platform contract for NVIDIA Dynamo v1.5.1 v1beta1. CI additionally validates against the upstream CRD.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "nvidia.com/v1beta1"
    },
    "kind": {
      "const": "DynamoGraphDeployment"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "annotations"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "labels": {
          "type": "object"
        },
        "annotations": {
          "type": "object",
          "required": [
            "inference.platform/model-id"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backendFramework",
        "components"
      ],
      "properties": {
        "backendFramework": {
          "const": "vllm"
        },
        "components": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "replicas",
              "podTemplate"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "frontend",
                  "worker",
                  "prefill",
                  "decode"
                ]
              },
              "replicas": {
                "type": "integer",
                "minimum": 1
              },
              "scalingAdapter": {
                "type": "object",
                "additionalProperties": false
              },
              "podTemplate": {
                "type": "object",
                "required": [
                  "spec"
                ],
                "properties": {
                  "spec": {
                    "type": "object",
                    "required": [
                      "containers"
                    ],
                    "properties": {
                      "containers": {
                        "type": "array",
                        "minItems": 1,
                        "contains": {
                          "type": "object",
                          "required": [
                            "name",
                            "image",
                            "command"
                          ],
                          "properties": {
                            "name": {
                              "const": "main"
                            },
                            "image": {
                              "type": "string",
                              "minLength": 1
                            },
                            "command": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "args": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "frontend"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "podTemplate": {
                      "properties": {
                        "spec": {
                          "properties": {
                            "containers": {
                              "contains": {
                                "properties": {
                                  "command": {
                                    "const": [
                                      "python3",
                                      "-m",
                                      "dynamo.frontend"
                                    ]
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "else": {
                  "properties": {
                    "podTemplate": {
                      "properties": {
                        "spec": {
                          "properties": {
                            "containers": {
                              "contains": {
                                "required": [
                                  "args",
                                  "resources"
                                ],
                                "properties": {
                                  "command": {
                                    "const": [
                                      "python3",
                                      "-m",
                                      "dynamo.vllm"
                                    ]
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "contains": {
            "properties": {
              "type": {
                "const": "frontend"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    }
  }
}
