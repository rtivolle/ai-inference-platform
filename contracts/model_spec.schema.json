{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.com/schemas/model_spec.schema.json",
  "title": "ModelDeploymentSpecification",
  "description": "Contracts for Model Deployment Request, Cluster Inventory, and Auto-Tuned Deployment Plan (R1/R2 Revision)",
  "$defs": {
    "DeployRequest": {
      "type": "object",
      "required": ["model_id"],
      "properties": {
        "model_id": {
          "type": "string",
          "description": "Hugging Face model identifier or S3 URI"
        },
        "model_revision": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{40}$",
          "description": "Optional immutable Hugging Face commit; pinned inspection, warming, and serving."
        },
        "deployment_name": {
          "type": "string",
          "description": "RFC 1123 compliant DNS name for the deployment. Generated if omitted.",
          "pattern": "^[a-z]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "profile": {
          "type": "string",
          "enum": ["low-latency", "high-throughput", "balanced"],
          "default": "balanced"
        },
        "dtype": {
          "type": "string",
          "enum": ["auto", "bfloat16", "float16", "bf16", "fp16"],
          "default": "auto"
        },
        "quantization": {
          "type": ["string", "null"],
          "enum": ["fp8", "awq", "gptq", null],
          "default": null
        },
        "max_model_len": {
          "type": "integer",
          "minimum": 512,
          "maximum": 131072
        },
        "gpu_memory_utilization": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 0.98,
          "default": 0.90
        },
        "target_concurrency": {
          "type": "integer",
          "minimum": 1,
          "default": 16
        }
      },
      "additionalProperties": false
    },
    "GpuPool": {
      "type": "object",
      "required": ["gpu_sku", "vram_gb", "total_count", "available_count"],
      "properties": {
        "gpu_sku": {
          "type": "string",
          "examples": ["NVIDIA-H100-80GB", "NVIDIA-A100-80GB", "NVIDIA-L40S"]
        },
        "vram_gb": {
          "type": ["number", "null"]
        },
        "total_count": {
          "type": "integer",
          "minimum": 0
        },
        "available_count": {
          "type": "integer",
          "minimum": 0
        },
        "rdma_supported": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "ClusterInventory": {
      "type": "object",
      "required": ["nodes_count", "gpu_pools"],
      "properties": {
        "nodes_count": {
          "type": "integer",
          "minimum": 1
        },
        "gpu_pools": {
          "type": "array",
          "items": { "$ref": "#/$defs/GpuPool" }
        },
        "rdma_network_active": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "CliqueSpec": {
      "type": "object",
      "required": ["replicas", "tensor_parallel_size", "pipeline_parallel_size", "gpu_sku"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "tensor_parallel_size": { "type": "integer", "enum": [1, 2, 4, 8] },
        "pipeline_parallel_size": { "type": "integer", "minimum": 1, "default": 1 },
        "gpu_sku": { "type": "string" },
        "max_num_batched_tokens": { "type": "integer" },
        "enable_chunked_prefill": { "type": "boolean" },
        "max_num_seqs": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "KVCacheTransferSpec": {
      "type": "object",
      "required": ["protocol", "engine"],
      "properties": {
        "protocol": { "type": "string", "enum": ["rdma", "tcp"] },
        "engine": { "type": "string", "enum": ["nixl", "ucx", "default"] }
      },
      "additionalProperties": false
    },
    "DeploymentPlan": {
      "type": "object",
      "required": [
        "model_id",
        "deployment_name",
        "serving_mode",
        "dtype",
        "max_model_len",
        "gpu_memory_utilization",
        "estimated_vram_gb_per_replica"
      ],
      "properties": {
        "model_id": { "type": "string" },
        "model_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "deployment_name": {
          "type": "string",
          "pattern": "^[a-z]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "serving_mode": { "type": "string", "enum": ["disaggregated", "aggregated"] },
        "dtype": { "type": "string", "enum": ["bfloat16", "float16", "auto", "bf16", "fp16"] },
        "quantization": {
          "type": ["string", "null"],
          "enum": ["fp8", "awq", "gptq", null]
        },
        "max_model_len": { "type": "integer" },
        "gpu_memory_utilization": { "type": "number", "minimum": 0.1, "maximum": 1.0 },
        "estimated_vram_gb_per_replica": { "type": "number" },
        "prefill_clique": { "$ref": "#/$defs/CliqueSpec" },
        "decode_clique": { "$ref": "#/$defs/CliqueSpec" },
        "worker_clique": { "$ref": "#/$defs/CliqueSpec" },
        "kv_cache_transfer": { "$ref": "#/$defs/KVCacheTransferSpec" }
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/DeployRequest" },
    { "$ref": "#/$defs/DeploymentPlan" },
    { "$ref": "#/$defs/ClusterInventory" }
  ]
}
