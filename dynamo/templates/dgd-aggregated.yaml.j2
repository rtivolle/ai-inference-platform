apiVersion: nvidia.com/v1alpha1
kind: DynamoGraphDeployment
metadata:
  name: "{{ deployment_name }}"
  namespace: "{{ namespace | default('dynamo-workloads') }}"
  labels:
    app.kubernetes.io/name: "{{ deployment_name }}"
    app.kubernetes.io/managed-by: dynamo-control-plane
    dynamo.nvidia.com/serving-mode: aggregated
spec:
  backend: vllm
  model: "{{ model_id }}"
  sharedStorage:
    hostPath: "/mnt/nvme/model-cache"
  services:
    Frontend:
      replicas: {{ frontend_replicas | default(2) }}
      ports:
        - name: http
          port: 8000
      env:
        - name: MODEL_ID
          value: "{{ model_id }}"
        - name: DISAGGREGATED_MODE
          value: "false"
    Worker:
      replicas: {{ worker_clique.replicas }}
      resources:
        limits:
          nvidia.com/gpu: {{ worker_clique.tensor_parallel_size }}
        requests:
          nvidia.com/gpu: {{ worker_clique.tensor_parallel_size }}
      env:
        - name: HF_HOME
          value: "/mnt/nvme/model-cache"
      extraArgs:
        - "--tensor-parallel-size={{ worker_clique.tensor_parallel_size }}"
        {% if worker_clique.pipeline_parallel_size and worker_clique.pipeline_parallel_size > 1 %}
        - "--pipeline-parallel-size={{ worker_clique.pipeline_parallel_size }}"
        {% endif %}
        - "--quantization={{ quantization }}"
        - "--max-model-len={{ max_model_len }}"
        - "--gpu-memory-utilization={{ gpu_memory_utilization }}"
        {% if worker_clique.max_num_seqs %}
        - "--max-num-seqs={{ worker_clique.max_num_seqs }}"
        {% endif %}
        - "--download-dir=/mnt/nvme/model-cache"
