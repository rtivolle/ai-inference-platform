apiVersion: batch/v1
kind: Job
metadata:
  name: "{{ deployment_name }}-warmer"
  namespace: "{{ namespace | default('dynamo-workloads') }}"
  labels:
    app.kubernetes.io/name: "{{ deployment_name }}-warmer"
    app.kubernetes.io/component: model-cache-warmer
spec:
  backoffLimit: 2
  ttlSecondsAfterFinished: 600
  template:
    metadata:
      labels:
        app.kubernetes.io/name: "{{ deployment_name }}-warmer"
    spec:
      restartPolicy: OnFailure
      {% if warmer_image_pull_secret %}
      imagePullSecrets:
        - name: "{{ warmer_image_pull_secret }}"
      {% endif %}
      {% if target_node %}
      nodeSelector:
        kubernetes.io/hostname: "{{ target_node }}"
      {% endif %}
      containers:
        - name: warmer
          image: "{{ warmer_image | default('ai-inference-model-warmer:latest') }}"
          imagePullPolicy: IfNotPresent
          args:
            - "--model-id"
            - "{{ model_id }}"
            - "--cache-dir"
            - "/mnt/nvme/model-cache"
          env:
            - name: HF_HOME
              value: "/mnt/nvme/model-cache"
            - name: HF_HUB_ENABLE_HF_TRANSFER
              value: "1"
            - name: HF_TOKEN
              valueFrom:
                secretKeyRef:
                  name: hf-token-secret
                  key: token
                  optional: true
          volumeMounts:
            - name: model-cache
              mountPath: /mnt/nvme/model-cache
          resources:
            requests:
              cpu: "2"
              memory: 4Gi
            limits:
              cpu: "8"
              memory: 16Gi
      volumes:
        - name: model-cache
          hostPath:
            path: /mnt/nvme/model-cache
            type: DirectoryOrCreate
