# KEDA ScaledObjects for NVIDIA Dynamo Workload
# PrefillWorker and DecodeWorker are scaled independently based on distinct operational bottlenecks.
---
apiVersion: keda.sh/v1alpha1
kind: ScaledObject
metadata:
  name: "{{ deployment_name }}-prefill-scaler"
  namespace: "{{ namespace | default('dynamo-workloads') }}"
  labels:
    app.kubernetes.io/managed-by: keda-autoscaler
    deployment: "{{ deployment_name }}"
    clique: prefill
spec:
  scaleTargetRef:
    apiVersion: nvidia.com/v1alpha1
    kind: DynamoGraphDeployment
    name: "{{ deployment_name }}"
    envSourceContainerName: PrefillWorker
  pollingInterval: 5
  cooldownPeriod: 30
  minReplicaCount: {{ prefill_min_replicas | default(1) }}
  maxReplicaCount: {{ prefill_max_replicas | default(8) }}
  advanced:
    horizontalPodAutoscalerConfig:
      behavior:
        scaleUp:
          stabilizationWindowSeconds: 0
          policies:
            - type: Percent
              value: 100
              periodSeconds: 15
        scaleDown:
          stabilizationWindowSeconds: 60
          policies:
            - type: Percent
              value: 25
              periodSeconds: 30
  triggers:
    - type: prometheus
      metadata:
        serverAddress: http://prometheus-k8s.monitoring.svc.cluster.local:9090
        metricName: vllm_num_requests_waiting
        query: sum(vllm:num_requests_waiting{model_name="{{ model_id }}"})
        threshold: "4" # Trigger prefill scaling when queue exceeds 4 waiting requests
---
apiVersion: keda.sh/v1alpha1
kind: ScaledObject
metadata:
  name: "{{ deployment_name }}-decode-scaler"
  namespace: "{{ namespace | default('dynamo-workloads') }}"
  labels:
    app.kubernetes.io/managed-by: keda-autoscaler
    deployment: "{{ deployment_name }}"
    clique: decode
spec:
  scaleTargetRef:
    apiVersion: nvidia.com/v1alpha1
    kind: DynamoGraphDeployment
    name: "{{ deployment_name }}"
    envSourceContainerName: DecodeWorker
  pollingInterval: 5
  cooldownPeriod: 45
  minReplicaCount: {{ decode_min_replicas | default(2) }}
  maxReplicaCount: {{ decode_max_replicas | default(16) }}
  advanced:
    horizontalPodAutoscalerConfig:
      behavior:
        scaleUp:
          stabilizationWindowSeconds: 0
          policies:
            - type: Percent
              value: 50
              periodSeconds: 15
        scaleDown:
          stabilizationWindowSeconds: 120
          policies:
            - type: Percent
              value: 10
              periodSeconds: 60
  triggers:
    - type: prometheus
      metadata:
        serverAddress: http://prometheus-k8s.monitoring.svc.cluster.local:9090
        metricName: vllm_gpu_cache_usage_perc
        query: max(vllm:gpu_cache_usage_perc{model_name="{{ model_id }}"})
        threshold: "0.85" # Trigger decode scaling when KV-cache saturation exceeds 85%
