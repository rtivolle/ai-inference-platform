# KEDA ScaledObjects for NVIDIA Dynamo Workload
# Prefill and Decode are scaled independently via DynamoGraphDeploymentScalingAdapter (DGDSA)
---
apiVersion: keda.sh/v1alpha1
kind: ScaledObject
metadata:
  name: "{{ deployment_name }}-prefill-scaler"
  namespace: "{{ namespace | default('dynamo-workloads') }}"
  labels:
    app.kubernetes.io/managed-by: keda-autoscaler
    deployment: "{{ deployment_name }}"
    clique: prefill
spec:
  scaleTargetRef:
    apiVersion: nvidia.com/v1beta1
    kind: DynamoGraphDeploymentScalingAdapter
    name: "{{ deployment_name }}-prefill"
  pollingInterval: 15
  cooldownPeriod: 120
  minReplicaCount: {{ prefill_clique.replicas }}
  maxReplicaCount: {{ prefill_max_replicas | default(prefill_clique.replicas * 4) }}
  advanced:
    horizontalPodAutoscalerConfig:
      behavior:
        scaleUp:
          stabilizationWindowSeconds: 0
          policies:
            - type: Percent
              value: 100
              periodSeconds: 15
        scaleDown:
          stabilizationWindowSeconds: 60
          policies:
            - type: Percent
              value: 25
              periodSeconds: 30
  triggers:
    - type: prometheus
      metadata:
        serverAddress: http://prometheus-kube-prometheus-prometheus.monitoring.svc.cluster.local:9090
        metricName: dynamo_ttft_p95_seconds
        threshold: "0.35"
        query: |
          histogram_quantile(0.95, sum(rate(dynamo_frontend_time_to_first_token_seconds_bucket{dynamo_namespace="{{ namespace | default('dynamo-workloads') }}-{{ deployment_name }}"}[2m])) by (le))
    - type: prometheus
      metadata:
        serverAddress: http://prometheus-kube-prometheus-prometheus.monitoring.svc.cluster.local:9090
        metricName: vllm_requests_waiting_prefill
        threshold: "5"
        query: |
          sum(vllm:num_requests_waiting{namespace="{{ namespace | default('dynamo-workloads') }}", dynamo_component="prefill", model_name="{{ model_id }}"})
---
apiVersion: keda.sh/v1alpha1
kind: ScaledObject
metadata:
  name: "{{ deployment_name }}-decode-scaler"
  namespace: "{{ namespace | default('dynamo-workloads') }}"
  labels:
    app.kubernetes.io/managed-by: keda-autoscaler
    deployment: "{{ deployment_name }}"
    clique: decode
spec:
  scaleTargetRef:
    apiVersion: nvidia.com/v1beta1
    kind: DynamoGraphDeploymentScalingAdapter
    name: "{{ deployment_name }}-decode"
  pollingInterval: 15
  cooldownPeriod: 180
  minReplicaCount: {{ decode_clique.replicas }}
  maxReplicaCount: {{ decode_max_replicas | default(decode_clique.replicas * 4) }}
  advanced:
    horizontalPodAutoscalerConfig:
      behavior:
        scaleUp:
          stabilizationWindowSeconds: 0
          policies:
            - type: Percent
              value: 50
              periodSeconds: 15
        scaleDown:
          stabilizationWindowSeconds: 120
          policies:
            - type: Percent
              value: 10
              periodSeconds: 60
  triggers:
    - type: prometheus
      metadata:
        serverAddress: http://prometheus-kube-prometheus-prometheus.monitoring.svc.cluster.local:9090
        metricName: vllm_gpu_cache_usage_perc
        threshold: "0.80"
        query: |
          avg(vllm:gpu_cache_usage_perc{namespace="{{ namespace | default('dynamo-workloads') }}", dynamo_component="decode", model_name="{{ model_id }}"})
